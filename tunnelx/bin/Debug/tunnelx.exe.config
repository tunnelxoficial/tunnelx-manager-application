<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <appSettings>
    <!-- Host (IP ou DNS) que os clientes usam no campo Endpoint do .conf.
         Deve apontar para onde existe port forward de UDP 51820. -->
    <add key="VpnEndpointHost" value="tunnelx.ddns.net" />
    <!-- false = compartilhamento de internet feito FORA do app (WinNAT/RRAS).
         true  = usa o ICS do Windows, que reescreve o tunel para 192.168.137.1/24. -->
    <!-- MTU gravado no .conf do cliente. 1280 e o piso seguro em rede movel;
         suba de 20 em 20 para achar o teto do caminho. Ver TunnelManager.ClientMtu. -->
    <add key="ClientMtu" value="1280" />
    <add key="UseIcs" value="false" />
    <!-- Conexao com o SQL Server. FICA VAZIA no repositorio de proposito:
         a string carrega usuario e senha, e este arquivo e versionado.
         Preencha na maquina que roda o provisionador, ou defina a variavel
         de ambiente TUNNELX_DB (que tem precedencia).
         Mantenha Encrypt=true: sem isso a chave privada de cada cliente
         trafega em claro pela internet ate o banco. -->
    <add key="DbConnectionString" value="Server=64.20.61.66,1433;Database=tunnelx;User Id=tunnelx;Password=TuNn3Lx2@25;Encrypt=false;" />
  </appSettings>
</configuration>